{
  "name": "boxcrete-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests and quality budgets for the BOxCrete interactive concrete strength explorer.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "serve": "http-server docs -p 4173 -s -c-1",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
